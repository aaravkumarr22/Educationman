{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information and role",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "student", "parent"] },
        "studentId": { "type": "string", "description": "Reference to student document if role is student or parent" }
      },
      "required": ["email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Detailed student profile and academic results",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "dob": { "type": "string", "description": "Date of birth (used for login)" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "class": { "type": "string" },
        "section": { "type": "string" },
        "result": { "type": "object", "description": "Academic results data" },
        "userId": { "type": "string", "description": "Reference to user document" },
        "photoURL": { "type": "string", "format": "uri", "description": "URL to student profile photo" },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "type": { "type": "string" }
            }
          },
          "description": "List of uploaded documents"
        }
      },
      "required": ["name", "class", "section", "dob"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a student",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Present", "Absent"] }
      },
      "required": ["studentId", "date", "status"]
    },
    "Notice": {
      "title": "Notice",
      "description": "School announcement or notice",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isImportant": { "type": "boolean" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content", "date", "authorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "School notices"
    }
  }
}
